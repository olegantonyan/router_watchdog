menu "Router watchdog"

    config RW_HOSTNAME
        string "Hostname (DHCP and mDNS, <name>.local)"
        default "router-watchdog"

    config RW_AP_SSID
        string "Access point SSID"
        default "router-watchdog"
        help
            A -XXXX suffix from the access point MAC address is appended.

    config RW_AP_PASSWORD
        string "Access point password"
        default "watchdog"
        help
            8-63 characters for WPA2-PSK. Leave empty for an open access point.

    config RW_AP_CHANNEL
        int "Access point channel"
        range 1 13
        default 1
        help
            Used until the Wi-Fi client connects; then the access point follows the client's channel.

    config RW_AP_MAX_CONN
        int "Maximum access point clients"
        range 1 10
        default 4

endmenu
